{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=NguyenNhatThanhDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Key": "YOUR_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG",
    "Issuer": "NguyenNhatThanhAuthServer",
    "Audience": "NguyenNhatThanhClientApp",
    "ExpiryMinutes": 120
  },
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "NguyenNhatThanh Security",
    "SenderEmail": "your_email@gmail.com",
    "AppPassword": "your_app_password",
    "EnableSsl": true
  }
}
